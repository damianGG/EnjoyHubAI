# Cloudinary Configuration
# Sign up at https://cloudinary.com and get your credentials from the Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only key. Never expose it through a NEXT_PUBLIC_ variable or browser code.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Feature flag for the first live checkout. Keep false in production until launch.
TICKETING_CHECKOUT_ENABLED=false
# Enables Stripe Checkout, webhook fulfillment, tickets and the host sales view.
# Keep false until the stage 1D migration and Stripe webhook are configured.
TICKETING_PAYMENTS_ENABLED=false
# Random server-only secret with at least 32 characters; used to HMAC IP/e-mail fingerprints.
TICKETING_FINGERPRINT_SECRET=replace_with_a_long_random_secret
# Vercel sends this value as a Bearer token to protected cron routes.
CRON_SECRET=replace_with_another_long_random_secret
# Stripe server key and signing secret. Neither value may use NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Public application URL used in confirmation, OAuth and password-reset links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# On Vercel preview deployments, when NEXT_PUBLIC_SITE_URL is not set,
# auth links fall back to VERCEL_URL.
# Optional callback override for local Supabase or preview environments
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# LocationIQ geocoding. Server-only: the browser calls EnjoyHub API routes, never LocationIQ directly.
LOCATIONIQ_API_KEY=replace_with_locationiq_access_token
# Comma-separated ISO 3166-1 alpha-2 codes. MVP is intentionally limited to Poland.
LOCATIONIQ_COUNTRY_CODES=pl

# Transactional email (Resend API). Server-only; never expose RESEND_API_KEY.
RESEND_API_KEY=re_replace_me
# Sender must use a domain verified in Resend.
EMAIL_FROM=EnjoyHub <hello@enjoyhub.app>
# Optional mailbox that should receive replies. Leave empty for no Reply-To header.
EMAIL_REPLY_TO=
# Optional canonical link origin used inside transactional emails.
# When omitted, NEXT_PUBLIC_SITE_URL / Vercel production URL is used.
EMAIL_SITE_URL=

# Safety switch used only by the destructive staging concurrency test.
# ALLOW_TICKETING_CONCURRENCY_TEST=true

# SMS Configuration for Phone Authentication
# Note: Supabase handles SMS sending through configured providers
# Configure in Supabase Dashboard > Authentication > Phone Auth
# Supported providers: Twilio, MessageBird, Textlocal, Vonage
# For SMSApi.pl integration, you may need to use a custom provider or webhook
NEXT_PUBLIC_ENABLE_PHONE_AUTH=true
